{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maty-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "kv_namespaces": [
    {
      "binding": "PROMO",
      "id": "dbadb4d19b8b4793aee7b99d34ed1de6"
    }
  ],
  "vars": {
    "MAIL_TO": "melorenzo@ymail.com",
    "MAIL_FROM": "Maty <no-reply@fullware.com.ar>",
    "ALLOWED_HOSTNAMES": "matiaslorenzo.fullware.com.ar,matiaslorenzo.com.ar",
    "PROMO_DISCOUNT": "10",
    "PROMO_SESSION_MINUTES": "30",
    "PROMO_TTL_DAYS": "30",
    "PROMO_DAILY_CAP": "15"
  },
  "ratelimits": [
    {
      "name": "PROMO_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
