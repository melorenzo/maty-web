{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maty-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "kv_namespaces": [
    {
      "binding": "PROMO",
      "id": "dbadb4d19b8b4793aee7b99d34ed1de6"
    }
  ],
  "ratelimits": [
    {
      "name": "PROMO_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
