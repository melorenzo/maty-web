# Secretos del runtime para el deploy con Docker.
# Copiá este archivo a secrets/.dev.vars y completá los valores.
# secrets/ está en .gitignore: este archivo nunca se versiona con secretos reales.

# --- Promo del arcade ---
PROMO_SECRET=cambiar-por-un-valor-aleatorio-largo
PROMO_DISCOUNT=10
PROMO_SESSION_MINUTES=30
PROMO_TTL_DAYS=30
PROMO_DAILY_CAP=15

# --- Contacto por email (Resend) ---
RESEND_API_KEY=
MAIL_TO=melorenzo@ymail.com
MAIL_FROM="Maty <no-reply@fullware.com.ar>"

# --- Contacto por Telegram (opcional, corre en paralelo al email) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Turnstile (anti-bot). Sin TURNSTILE_SECRET el formulario omite la verificación ---
TURNSTILE_SECRET=
ALLOWED_HOSTNAMES=matiaslorenzo.fullware.com.ar,matiaslorenzo.com.ar
