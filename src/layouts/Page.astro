---
import Base from './Base.astro';
import Dock from '../components/astro/Dock.astro';
import Footer from '../components/astro/Footer.astro';
import CommandPalette from '../components/react/CommandPalette.tsx';
import ThemeToggle from '../components/react/ThemeToggle.tsx';
import { dockApps } from '../data/dock';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, eyebrow, image, noindex } = Astro.props;
---

<Base title={title} description={description} image={image} noindex={noindex}>
    <main id="contenido" class="mx-auto max-w-6xl px-4 pb-28 pt-8">
      <header class="mb-10">
        <a href="/" class="font-mono-label text-text-muted hover:text-accent">← escritorio</a>
        {eyebrow && <p class="font-mono-label mt-6 text-accent">{eyebrow}</p>}
        <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
        {description && <p class="mt-3 max-w-2xl text-lg text-text-muted">{description}</p>}
      </header>

      <slot />
    </main>

  <Dock apps={dockApps} />
  <CommandPalette client:idle />
  <ThemeToggle client:idle />
  <Footer />
</Base>
