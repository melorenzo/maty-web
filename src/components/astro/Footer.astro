---
import { links, emails } from '../../data/links';
import { AUTHOR } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface/80">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-3">
    <div>
      <p class="font-mono-label text-accent">Maty</p>
      <p class="mt-2 text-sm text-text-muted">
        {AUTHOR.role}. <br />
        {AUTHOR.city}.
      </p>
    </div>

    <nav aria-label="Enlaces del sitio">
      <p class="font-mono-label mb-2 text-text-muted">Sitio</p>
      <ul class="space-y-1 text-sm">
        <li><a class="hover:text-accent" href="/proyectos">Proyectos</a></li>
        <li><a class="hover:text-accent" href="/aula">En el aula</a></li>
        <li><a class="hover:text-accent" href="/software-libre">Software libre</a></li>
        <li><a class="hover:text-accent" href="/servicios">Servicios</a></li>
        <li><a class="hover:text-accent" href="/arcade">Arcade</a></li>
        <li><a class="hover:text-accent" href="/cv">CV</a></li>
        <li><a class="hover:text-accent" href="/contacto">Contacto</a></li>
        <li><a class="hover:text-accent" href="/man">Manual</a></li>
      </ul>
    </nav>

    <div>
      <p class="font-mono-label mb-2 text-text-muted">Fuera del sitio</p>
      <ul class="space-y-1 text-sm">
        {
          links
            .filter((link) => link.external)
            .map((link) => (
              <li>
                <a class="hover:text-accent" href={link.href} target="_blank" rel="noreferrer noopener">
                  {link.label}
                </a>
              </li>
            ))
        }
        {
          emails.map((email) => (
            <li>
              <a class="hover:text-accent" href={`mailto:${email}`}>
                {email}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-border px-4 py-4">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 font-mono text-xs text-text-muted sm:flex-row"
    >
      <p>© {year} Matías Lorenzo · Buenos Aires</p>
      <p class="flex items-center gap-2">
        <a class="hover:text-accent" href="/software-libre">este sitio es software libre</a>
      </p>
    </div>
  </div>
</footer>
