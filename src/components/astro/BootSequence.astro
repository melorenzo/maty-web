---
interface Props {
  lines: { text: string; ok?: boolean; delay?: number }[];
}

const { lines } = Astro.props;
---

<div
  class="terminal-surface overflow-x-auto p-4 text-xs leading-relaxed sm:text-sm"
  role="img"
  aria-label="Registro de arranque del sitio"
>
  <ol class="space-y-1">
    {
      lines.map((line, index) => (
        <li
          class="flex gap-2 opacity-0 [animation:boot-line_0.4s_ease-out_forwards]"
          style={`animation-delay:${(line.delay ?? index * 120) + 100}ms`}
        >
          <span class="shrink-0 text-slate-400">{line.ok === false ? '[FAIL]' : '[ OK ]'}</span>
          <span class={line.ok === false ? 'text-[#ff8a80]' : 'text-emerald-400'}>{line.text}</span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  @keyframes boot-line {
    from {
      opacity: 0;
      transform: translateY(2px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
