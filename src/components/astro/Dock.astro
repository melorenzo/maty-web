---
interface App {
  id: string;
  label: string;
  href: string;
  icon: string;
}

interface Props {
  apps: App[];
}

const { apps } = Astro.props;

const icons: Record<string, string> = {
  about:
    'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm-1.5 6h3v6h-3v-6Z',
  stack:
    'M4 4h7v7H4V4Zm9 0h7v4h-7V4ZM4 13h7v7H4v-7Zm9-3h7v10h-7V10Z',
  projects:
    'M3 5a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5Z',
  aula:
    'M3 4h18v12H3V4Zm2 2v8h14V6H5Zm0 14h6v2H5v-2Zm8 0h6v2h-6v-2Z',
  foss:
    'M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-4Zm0 4.2 4 2v3.8c0 3-1.7 5.3-4 6.4-2.3-1.1-4-3.4-4-6.4V8.2l4-2Z',
  arcade:
    'M7 6h10a5 5 0 0 1 5 5v2a5 5 0 0 1-5 5h-2l-1.5-2h-3L9 18H7a5 5 0 0 1-5-5v-2a5 5 0 0 1 5-5Zm1.5 4v2h2v-2h-2Zm7 0a1.25 1.25 0 1 0 0 2.5A1.25 1.25 0 0 0 15.5 10ZM12 11v2h-2v-2h2Z',
  blog:
    'M5 3h11l3 3v15H5V3Zm2 2v14h10V8h-3V5H7Zm2 5h6v2H9v-2Zm0 4h6v2H9v-2Z',
  contacto:
    'M3 5h18v14H3V5Zm2 2v.3l7 4.7 7-4.7V7H5Zm0 2.6V17h14V9.6l-7 4.7-7-4.7Z',
  servicios:
    'M12 2 2 7l10 5 10-5-10-5Zm-8.5 9.2v4.1c0 2.4 3.8 4.7 8.5 4.7s8.5-2.3 8.5-4.7v-4.1L12 14.2l-8.5-3Z',
  cv: 'M6 2h8l4 4v16H6V2Zm7 2H8v16h8V7h-3V4Zm-4 8h6v2H9v-2Zm0 4h6v2H9v-2Z',
};
---

<nav
  aria-label="Aplicaciones del escritorio"
  class="fixed inset-x-0 bottom-0 z-40 flex justify-center px-2 pb-2"
>
  <ul
    class="flex max-w-full items-end gap-1 overflow-x-auto rounded-xl border border-border bg-surface/95 p-2 shadow-window backdrop-blur"
  >
    {
      apps.map((app) => (
        <li>
          <a
            href={app.href}
            class="group flex w-14 flex-col items-center gap-1 rounded-lg px-1 py-2 transition-colors hover:bg-surface-2"
          >
            <span
              class="flex size-9 items-center justify-center rounded-lg bg-surface-2 text-text-muted transition-colors group-hover:bg-accent group-hover:text-accent-contrast"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" class="size-5 fill-current">
                <path d={icons[app.icon] ?? icons.about} />
              </svg>
            </span>
            <span class="font-mono-label text-[0.55rem] text-text-muted group-hover:text-text">
              {app.label}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
