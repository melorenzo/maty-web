---
import type { ExperienceItem } from '../../data/types';
import Tag from './Tag.astro';

interface Props {
  item: ExperienceItem;
}

const { item } = Astro.props;
---

<li class="relative pl-8">
  <span
    class="absolute left-0 top-1.5 size-3 rounded-full border-2 border-accent bg-bg"
    aria-hidden="true"
  ></span>
  <span
    class="absolute left-[5px] top-6 h-[calc(100%-1.5rem)] w-px bg-border"
    aria-hidden="true"
  ></span>

  <p class="font-mono text-xs text-text-muted">commit {item.id.slice(0, 7)} · {item.period}</p>
  <h3 class="mt-1 text-base font-bold tracking-tight">{item.role}</h3>
  <p class="text-sm text-accent">{item.org}</p>
  <p class="mt-2 text-sm text-text-muted">{item.summary}</p>

  <ul class="mt-3 space-y-1.5 text-sm text-text-muted">
    {item.highlights.map((highlight) => (
      <li class="flex gap-2">
        <span class="text-ok" aria-hidden="true">+</span>
        <span>{highlight}</span>
      </li>
    ))}
  </ul>

  <ul class="mt-3 flex flex-wrap gap-1.5">
    {item.tags.map((tag) => <Tag label={tag} as="li" />)}
  </ul>
</li>
