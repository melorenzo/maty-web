---
import Page from '../layouts/Page.astro';
import Window from '../components/astro/Window.astro';
import Tag from '../components/astro/Tag.astro';
import Callout from '../components/astro/Callout.astro';
import { getCollection } from 'astro:content';
import { metodologia, rutas, materias } from '../data/aula';
import { experiencia } from '../data/experiencia';

const materiales = (await getCollection('materiales')).filter((item) => !item.data.draft);

const contenido = { metodologia, rutas, materias, experiencia, materiales };
---

<Page
  title="En el aula"
  eyebrow="~/aula"
  description="Docencia de tecnología en secundario, terciario y universidad. Qué enseño, cómo lo enseño y con qué material."
>
  <Window title="metodologia" status="running">
    <div class="grid gap-4 md:grid-cols-2">
      {
        contenido.metodologia.map((item) => (
          <div class="rounded-lg border border-border bg-surface-2 p-5">
            <h2 class="font-semibold">{item.title}</h2>
            <p class="mt-2 text-sm text-text-muted">{item.summary}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {item.topics.map((topic) => (
                <Tag label={topic} as="li" />
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Window>

  <Window title="materias" class="mt-8">
    <ul class="flex flex-wrap gap-1.5">
      {contenido.materias.map((materia) => <Tag label={materia} as="li" />)}
    </ul>
    <p class="mt-4 text-sm text-text-muted">
      Las mismas clases se adaptan por nivel: no es el mismo ejemplo para segundo año de secundaria
      que para una cátedra de textos digitales.
    </p>
  </Window>

  <Window title="rutas-de-aprendizaje" class="mt-8">
    <div class="grid gap-4 md:grid-cols-2">
      {
        contenido.rutas.map((ruta) => (
          <div class="rounded-lg border border-border bg-surface p-5">
            <div class="flex items-baseline justify-between gap-2">
              <h2 class="font-semibold">{ruta.title}</h2>
              <span class="font-mono text-xs text-text-muted">{ruta.duration}</span>
            </div>
            <p class="mt-1 font-mono text-xs text-accent">{ruta.level}</p>
            <p class="mt-2 text-sm text-text-muted">{ruta.outcome}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {ruta.topics.map((topic) => (
                <Tag label={topic} as="li" />
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Window>

  <Window title="materiales" class="mt-8">
    {
      contenido.materiales.length === 0 ? (
        <Callout title="TODO(matias)" tone="muted">
          <p>
            Falta publicar las guías y consignas del aula. El formato va a ser: cada material es un
            repositorio abierto con licencia, para que otro docente lo use, lo cambie y lo comparta.
          </p>
        </Callout>
      ) : (
        <ul class="space-y-3">
          {contenido.materiales.map((material) => (
            <li class="rounded-lg border border-border bg-surface-2 p-4">
              <h2 class="font-semibold">{material.data.title}</h2>
              <p class="mt-1 text-sm text-text-muted">{material.data.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
  </Window>

  <Window title="docencia" class="mt-8">
    <ul class="space-y-4">
      {
        contenido.experiencia
          .filter((item) => item.id === 'facilitador-pedagogico-digital' || item.id === 'docente-de-tecnologia')
          .map((item) => (
            <li>
              <p class="font-semibold">{item.role}</p>
              <p class="text-sm text-accent">{item.org}</p>
              <p class="font-mono text-xs text-text-muted">{item.period}</p>
              <p class="mt-1 text-sm text-text-muted">{item.summary}</p>
            </li>
          ))
      }
    </ul>
  </Window>
</Page>
