---
import Page from '../layouts/Page.astro';
import Window from '../components/astro/Window.astro';
import BlogPosts from '../components/react/BlogPosts';
import { getLatestPosts } from '../lib/blog';

const posts = await getLatestPosts(20);
---

<Page
  title="Blog"
  eyebrow="~/blog"
  description="Notas sobre tecnología, automatización, docker, IA y software libre. También en blog.fullware.com.ar."
>
  <Window title="tail -n 20 posts" status="running">
    <BlogPosts client:idle initialPosts={posts} limit={20} variant="blog" />

    <p class="mt-6 font-mono text-xs text-text-muted">
      <a class="text-accent hover:underline" href="https://blog.fullware.com.ar">
        blog.fullware.com.ar
      </a>
      ·
      <a class="text-accent hover:underline" href="/rss.xml">rss</a>
    </p>
  </Window>
</Page>
