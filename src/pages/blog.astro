---
import Page from '../layouts/Page.astro';
import Window from '../components/astro/Window.astro';
import { getLatestPosts, formatDate } from '../lib/blog';

const posts = await getLatestPosts(20);
---

<Page
  title="Blog"
  eyebrow="~/blog"
  description="Notas sobre tecnología, automatización, docker, IA y software libre. También en blog.fullware.com.ar."
>
  <Window title="tail -n 20 posts" status="running">
    {
      posts.length === 0 ? (
        <p class="text-sm text-text-muted">
          No pude leer el feed en este build. Podés entrar directo al blog:{' '}
          <a class="text-accent underline underline-offset-2" href="https://blog.fullware.com.ar">
            blog.fullware.com.ar
          </a>
          .
        </p>
      ) : (
        <ul class="space-y-4">
          {posts.map((post) => (
            <li class="border-b border-border pb-4 last:border-0 last:pb-0">
              <p class="font-mono text-xs text-text-muted">{formatDate(post.date)}</p>
              <a
                class="mt-1 block text-lg font-semibold hover:text-accent"
                href={post.link}
                target="_blank"
                rel="noreferrer noopener"
              >
                {post.title}
              </a>
              {post.excerpt && <p class="mt-1 text-sm text-text-muted">{post.excerpt}…</p>}
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-6 font-mono text-xs text-text-muted">
      <a class="text-accent hover:underline" href="https://blog.fullware.com.ar">
        blog.fullware.com.ar
      </a>
      ·
      <a class="text-accent hover:underline" href="/rss.xml">rss</a>
    </p>
  </Window>
</Page>
