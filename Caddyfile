{$SITE_DOMAIN:matiaslorenzo.com.ar} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Assets con hash: cache larga
	@assets path /_astro/* /audio/* /avatar.webp /og-maty.jpg
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Si el contenedor de la app se reinicia, workerd tarda ~20s en volver a
	# levantar: con health check activo Caddy espera en vez de devolver 502.
	reverse_proxy web:4321 {
		health_uri /
		health_interval 10s
		health_timeout 5s
		lb_try_duration 30s
	}
}

www.{$SITE_DOMAIN:matiaslorenzo.com.ar} {
	redir https://{$SITE_DOMAIN:matiaslorenzo.com.ar}{uri} permanent
}
