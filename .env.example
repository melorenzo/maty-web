# Dominio y URL canónica del sitio
SITE_URL=https://matiaslorenzo.com.ar

# Turnstile (protección del formulario de contacto)
PUBLIC_SITEKEY_TURNSTILE=
TURNSTILE_SECRET=

# Resend (envío de emails del formulario de contacto)
RESEND_API_KEY=
MAIL_TO=melorenzo@fullware.com.ar,melorenzo@ymail.com
MAIL_FROM="Maty <no-reply@matiaslorenzo.com.ar>"

# Telegram (notificación opcional en paralelo al email)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Promo del arcade
PROMO_SECRET=
PROMO_DISCOUNT=10
PROMO_SESSION_MINUTES=30
PROMO_TTL_DAYS=30
PROMO_DAILY_CAP=50

# Hostnames permitidos por Turnstile (separados por coma, sin localhost en producción)
ALLOWED_HOSTNAMES=matiaslorenzo.com.ar
