# Variables que se hornean en el build de Docker (docker-compose las pasa como build args).
# Las variables de runtime (Turnstile, Resend, promo, Telegram) van en secrets/.dev.vars:
# copiá secrets/.dev.vars.example a secrets/.dev.vars y completalas.

# Dominio y URL canónica del sitio (sitemap, canonical, Open Graph)
PUBLIC_SITE_URL=https://matiaslorenzo.fullware.com.ar

# Turnstile: clave pública del widget (va en el bundle del navegador)
PUBLIC_SITEKEY_TURNSTILE=0x4AAAAAAByHbb24KABm68eu
